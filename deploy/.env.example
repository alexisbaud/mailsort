# Secrets de mailsort sur le VPS. Sur le serveur : copier ce fichier en /srv/mailsort/.env
# (sans le suffixe .example), le remplir, puis `chmod 600 .env`. Ne jamais le commiter.
# Garder une copie du fichier rempli dans le gestionnaire de mots de passe.

# Nom du site sur la plateforme (dossier /srv/mailsort, conteneurs mailsort-…).
SITE=mailsort

# --- Jev (TypeSafe) -----------------------------------------------------------
# Clé dédiée au VPS, créée sur https://console.typesafe.ai/keys (une clé par machine :
# on peut révoquer celle du VPS sans toucher à celle du Mac).
TYPESAFE_API_KEY=
# Version de Jev épinglée : la changer fait reposer toutes les questions.
JEV_MODEL=jev-1.14.0
JEV_MAX_REQUESTS_PER_SECOND=10

# --- Gmail --------------------------------------------------------------------
# Budget d'unités de quota par minute (Gmail en autorise 15 000).
GMAIL_QUOTA_UNITS_PER_MINUTE=6000
# Adresses de l'utilisateur, séparées par des virgules (les mêmes que dans le .env du Mac).
MAILSORT_USER_EMAILS=

# Les chemins (base, jeton, journal, labels.yaml) sont fixés dans compose.yml : ne pas les
# ajouter ici.

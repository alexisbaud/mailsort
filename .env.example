# Copier ce fichier en .env et le remplir. Le fichier .env ne doit jamais être commité.

# Clé Vercel AI Gateway (accès à Jev)
AI_GATEWAY_API_KEY=

# Fichiers OAuth Google (créés hors du dépôt, ignorés par git)
GOOGLE_CLIENT_SECRET_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Configuration des labels
MAILSORT_LABELS=labels.yaml

# Base SQLite et journal
MAILSORT_DB=mailsort.db
MAILSORT_LOG_DIR=logs

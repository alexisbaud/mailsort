# Dupliquer ce fichier en .env (sans le suffixe .example) et le remplir.
# Le fichier .env est ignoré par git : il ne doit jamais être commité.

# --- Jev (TypeSafe) -----------------------------------------------------------
# Clé à créer sur https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
# Version de Jev épinglée : la changer déclenche une nouvelle évaluation de tous les mails.
JEV_MODEL=jev-1.14.0
# Nombre maximal d'appels par seconde (les limites du compte sont dans la console TypeSafe).
JEV_MAX_REQUESTS_PER_SECOND=10

# --- Gmail --------------------------------------------------------------------
# Fichiers OAuth Google (ignorés par git)
GOOGLE_CLIENT_SECRET_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Adresses de l'utilisateur, séparées par des virgules. Servent à savoir s'il est destinataire
# direct, en copie ou via une liste. Utile pour `mailsort classify` sur un .eml ; avec Gmail,
# l'adresse du compte est ajoutée automatiquement.
MAILSORT_USER_EMAILS=you@example.com

# --- mailsort -----------------------------------------------------------------
MAILSORT_LABELS=labels.yaml
MAILSORT_DB=mailsort.db
MAILSORT_LOG_DIR=logs
